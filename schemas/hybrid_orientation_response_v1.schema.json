{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fourgraph.local/schemas/hybrid_orientation_response_v1.schema.json",
  "title": "FourGraph Hybrid Semantic Orientation Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "orientation_decisions"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "fourgraph.hybrid_orientation_response.v1"
    },
    "orientation_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["left", "right", "relation", "confidence", "rationale"],
        "properties": {
          "left": {"type": "string", "pattern": "^X[0-9]{3}$"},
          "right": {"type": "string", "pattern": "^X[0-9]{3}$"},
          "relation": {
            "enum": ["left_causes_right", "right_causes_left"]
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
